#!/bin/bash
# Apply Bento's settings (defaults.json + ~/.config/bento/settings.json) to the
# places outside Hyprland's Lua, then reload Hyprland:
#
#   pages.dots        the bar shows Bento's page dots instead of Omarchy's numbers
#   terminal.ghostty  Ghostty includes Bento's Mac keys
#
# If Hyprland or one of Bento's modules reports errors, the previous settings
# (settings.json.prev, kept by the Bento app) go back and Hyprland reloads again.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)
config="${XDG_CONFIG_HOME:-$HOME/.config}/bento/settings.json"
state="$HOME/.local/state/bento"
shell_json="$HOME/.config/omarchy/shell.json"
ghostty_config="$HOME/.config/ghostty/config"
ghostty_line="config-file = ?\"$repo/ghostty/bento.conf\""
plugin="io.github.benjaminsehl.bento"

setting() { # section key
  jq -r --arg s "$1" --arg k "$2" '(.[1][$s][$k]) as $u | (.[0][$s][$k]) as $d
    | if $u != null and ($u | type) == ($d | type) then $u else $d end' \
    -s "$repo/defaults.json" <(cat "$config" 2>/dev/null || echo '{}')
}

# The bar: swap Omarchy's workspace numbers and Bento's dots (and the dots of
# Bento's earlier names: the standalone Pages plugin, then omac) in whichever
# section they sit.
legacy='"io.github.benjaminsehl.pages","io.github.benjaminsehl.omac"'
if [[ -f $shell_json ]]; then
  if [[ $(setting pages dots) == true ]]; then from="[\"omarchy.workspaces\",$legacy]"; to=$plugin
  else from="[\"$plugin\",$legacy]"; to=omarchy.workspaces; fi
  new=$(jq --argjson from "$from" --arg to "$to" '
    if .bar.layout then .bar.layout |= with_entries(.value |= map(if (.id as $id | $from | index($id)) then .id = $to else . end)) else . end' "$shell_json")
  if [[ $new != "$(<"$shell_json")" ]]; then
    cp "$shell_json" "$shell_json.bak.$(date +%s)"
    printf '%s\n' "$new" > "$shell_json"
  fi
fi

# Ghostty: include Bento's Mac keys after the user's own config, or take them out.
if [[ -f $ghostty_config ]]; then
  has=no; grep -qxF "$ghostty_line" "$ghostty_config" && has=yes
  want=no; [[ $(setting terminal ghostty) == true ]] && want=yes
  if [[ $want == yes && $has == no ]]; then
    printf '\n# Added by Bento: Mac keys under the Bento layout.\n%s\n' "$ghostty_line" >> "$ghostty_config"
  elif [[ $want == no && $has == yes ]]; then
    grep -vxF "$ghostty_line" "$ghostty_config" | grep -vxF "# Added by Bento: Mac keys under the Bento layout." > "$ghostty_config.bento-tmp"
    mv "$ghostty_config.bento-tmp" "$ghostty_config"
  fi
  if [[ $want != "$has" ]] && command -v omarchy-restart-terminal >/dev/null; then
    omarchy-restart-terminal >/dev/null 2>&1 || true
  fi
fi

# Hyprland: reload, and roll back if it, or a Bento module, complains.
check() {
  hyprctl reload >/dev/null
  sleep 0.3
  local errors
  errors=$(hyprctl configerrors)
  [[ -n ${errors//[[:space:]]/} ]] && { echo "$errors"; return 1; }
  [[ -s $state/errors ]] && { cat "$state/errors"; return 1; }
  return 0
}

if ! errors=$(check); then
  if [[ -f $config.prev ]]; then cp "$config.prev" "$config"; else rm -f "$config"; fi
  check >/dev/null || true
  echo "$errors" >&2
  exit 1
fi
