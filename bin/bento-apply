#!/bin/bash
# Apply Bento's settings (defaults.json + ~/.config/bento/settings.json) to the
# places outside Hyprland's Lua, then reload Hyprland:
#
#   terminal.ghostty  Ghostty includes Bento's Mac keys
#
# If the reload gives Hyprland, or one of Bento's modules, errors it didn't
# have before, the previous file (NAME.prev, kept by the Bento app) goes back
# and Hyprland reloads again. No NAME.prev means the app has just created the
# file, so it goes.
#
#   bento-apply                        after settings.json changed
#   bento-apply --file keyboards.json  after another file in ~/.config/bento did
#   bento-apply --no-rollback          apply and reload, report errors, but
#                                      leave every file alone: install.sh, which
#                                      changes code, never settings
set -euo pipefail

usage() { echo "Usage: bento-apply [--file NAME] [--no-rollback]  (NAME: a file in ~/.config/bento, default settings.json)" >&2; exit 2; }
name=settings.json
rollback=yes
while (( $# )); do
  case $1 in
    --file)
      [[ -n ${2:-} && $2 != */* && $2 != . && $2 != .. ]] || usage
      name=$2
      shift 2
      ;;
    --no-rollback) rollback=no; shift ;;
    *) usage ;;
  esac
done

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)
configdir="${XDG_CONFIG_HOME:-$HOME/.config}/bento"
config="$configdir/settings.json"
file="$configdir/$name"
state="$HOME/.local/state/bento"
# The real file, if it is a symlink into a dotfiles repo: the temp file that
# replaces it has to sit next to it.
ghostty_config=$(readlink -f "$HOME/.config/ghostty/config" 2>/dev/null) || ghostty_config="$HOME/.config/ghostty/config"
ghostty_mark="# Added by Bento: Mac keys under the Bento layout."
ghostty_line="config-file = ?\"$repo/ghostty/bento.conf\""

setting() { # section key
  jq -r --arg s "$1" --arg k "$2" '(.[1][$s][$k]) as $u | (.[0][$s][$k]) as $d
    | if $u != null and ($u | type) == ($d | type) then $u else $d end' \
    -s "$repo/defaults.json" <(cat "$config" 2>/dev/null || echo '{}')
}

# Ghostty: include Bento's Mac keys after the user's own config, or take them
# out again with the comment and blank line that came with them.
if [[ -f $ghostty_config ]]; then
  has=no; grep -qxF "$ghostty_line" "$ghostty_config" && has=yes
  want=no; [[ $(setting terminal ghostty) == true ]] && want=yes
  if [[ $want != "$has" ]]; then
    tmp="$ghostty_config.tmp.$$"
    if [[ $want == yes ]]; then
      { cat "$ghostty_config"; printf '\n%s\n%s\n' "$ghostty_mark" "$ghostty_line"; } >"$tmp"
    else
      MARK=$ghostty_mark LINE=$ghostty_line awk '
        { line[NR] = $0 }
        END {
          for (i = 1; i <= NR; i++) {
            if (line[i] == ENVIRON["MARK"] || line[i] == ENVIRON["LINE"]) continue
            if (line[i] == "" && line[i + 1] == ENVIRON["MARK"]) continue
            print line[i]
          }
        }' "$ghostty_config" >"$tmp"
    fi
    chmod --reference="$ghostty_config" "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$ghostty_config"
    if command -v omarchy-restart-terminal >/dev/null; then
      omarchy-restart-terminal >/dev/null 2>&1 || true
    fi
  fi
fi

# Omarchy holds Hyprland's reloads while it updates packages, and reloads
# itself when it is done; the new settings take effect then.
if compgen -G "${OMARCHY_HYPRLAND_RELOAD_GUARD_STATE_DIR:-/run/omarchy/hyprland-reload-guard}/*" >/dev/null; then
  echo "bento: Hyprland reloads are on hold for an update; the change applies when it finishes" >&2
  exit 0
fi

# Hyprland: reload, and roll back if it, or a Bento module, has something new
# to complain about. Errors that were there before aren't this change's.
errors_before=$(hyprctl configerrors 2>/dev/null || true)
modules_before=$(cat "$state/errors" 2>/dev/null || true)
new_lines() { # before after: the lines of after that before doesn't have
  grep -vxF -f <(printf '%s\n' "$1") <<<"$2" | grep -v '^[[:space:]]*$' || true
}
check() {
  hyprctl reload >/dev/null
  sleep 0.3
  local new
  new=$(
    new_lines "$errors_before" "$(hyprctl configerrors 2>/dev/null || true)"
    new_lines "$modules_before" "$(cat "$state/errors" 2>/dev/null || true)"
  )
  [[ -z $new ]] || { echo "$new"; return 1; }
}

if ! errors=$(check); then
  if [[ $rollback == yes ]]; then
    if [[ -f $file.prev ]]; then cp "$file.prev" "$file"; else rm -f "$file"; fi
    check >/dev/null || true
  fi
  echo "$errors" >&2
  exit 1
fi
